# PureTechs — cache rules for Netlify / Cloudflare Pages. Ignored elsewhere.
# CSS and JS are referenced with ?v=… : cache for a year.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
# Fonts and logos are not versioned: a week, then revalidate.
/assets/fonts/*
  Cache-Control: public, max-age=604800
/assets/logos/*
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
